<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Catppuccin" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/lavender</item>
        <item name="colorOnPrimary">@color/crust</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/mauve</item>
        <item name="colorSecondaryVariant">@color/pink</item>
        <item name="colorOnSecondary">@color/crust</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/base</item>
        <item name="colorOnBackground">@color/text</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/mantle</item>
        <item name="colorOnSurface">@color/text</item>

        <!-- Error colors -->
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/crust</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/crust</item>
        <item name="android:navigationBarColor">@color/crust</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/subtext1</item>
        <item name="android:textColorTertiary">@color/subtext0</item>

        <!-- Ripple effect -->
        <item name="colorControlHighlight">@color/surface2</item>

        <!-- Component styling -->
        <item name="materialCardViewStyle">@style/Widget.Catppuccin.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.Catppuccin.BottomNavigation</item>
    </style>

    <!-- Stili custom per componenti specifici -->
    <style name="Widget.Catppuccin.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface0</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Widget.Catppuccin.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/mantle</item>
        <item name="itemIconTint">@color/blue</item>
        <item name="itemTextColor">@color/subtext1</item>
    </style>
</resources>